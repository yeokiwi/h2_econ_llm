# Copy this file to .env and edit it. .env is not committed to git.

# OpenRouter model used for every request (see https://openrouter.ai/models).
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Optional: hold the OpenRouter key on the server so users don't need their own.
# Leave empty to have each user enter their own key in the browser.
OPENROUTER_API_KEY=

# Recommended whenever OPENROUTER_API_KEY is set on a public server:
# users must enter this code before the server's key is used.
ACCESS_CODE=

# PORT=8080
# HOST=0.0.0.0
